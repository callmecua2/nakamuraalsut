---
// src/layouts/Layout.astro
import Navbar from "../components/UI/Navbar.astro";
import Footer from "../components/UI/Footer.astro";
import "../styles/global.css"; // <-- Global CSS Diimpor di Sini
import ogCover from "../assets/images/nkmr/_MEM2081.JPG.webp";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = "Nakamura Alam Sutera – Refleksi Keluarga & Terapi Holistik Jepang",
  description = "Refleksi Keluarga & Terapi Holistik Jepang di Alam Sutera",
  noindex = false,
} = Astro.props;

const canonicalUrl = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).toString()
  : Astro.url.toString();

const ogImage = new URL(ogCover.src, Astro.site).toString();

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "HealthAndBeautyBusiness",

  name: "Nakamura Alam Sutera",

  url: Astro.site?.toString(),

  telephone: "+6285778899198",

  email: "nalsut20a@gmail.com",

  image: ogImage,

  address: {
    "@type": "PostalAddress",
    streetAddress:
      "ALAM SUTERA, Jl. Jalur Sutera No.2 Kav.20A, RT.002/RW.015, Kunciran",
    addressLocality: "Kota Tangerang",
    addressRegion: "Banten",
    postalCode: "15144",
    addressCountry: "ID",
  },

  openingHours: "Mo-Su 10:00-22:00",

  sameAs: ["https://www.instagram.com/nakamura_alamsutera"],

  hasMap: "https://maps.app.goo.gl/2J23hJhsYMN5zkKk6",
};
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />

    <meta property="og:title" content={title} />

    <meta property="og:description" content={description} />

    <meta property="og:url" content={canonicalUrl} />

    <meta property="og:image" content={ogImage} />

    <meta property="og:site_name" content="Nakamura Alam Sutera" />

    <meta property="og:locale" content="id_ID" />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(localBusinessSchema)}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- CDN Fonts & Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Noto+Sans:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Poppins:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css"
    />
  </head>
  <body>
    <Navbar />
    <slot />
    <Footer />
  </body>
</html>
