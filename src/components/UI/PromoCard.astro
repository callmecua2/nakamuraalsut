---
export interface Props {
  title: string;
  description: string;
  day: string;
  discount: string;
  icon: string;
  badge: string;
}

const { title, description, day, discount, icon, badge } = Astro.props;
---

<div class="promo-card">
  <div class="promo-card__badge">{badge}</div>
  <div class="promo-card__icon">{icon}</div>
  <div class="promo-card__discount">{discount}</div>
  <h3 class="promo-card__title">{title}</h3>
  <p class="promo-card__description">{description}</p>
  <div class="promo-card__day">📅 {day}</div>
</div>

<style>
  .promo-card {
    background: var(--surface);
    border-radius: var(--radius-lg);
    padding: 1.75rem 1.5rem 1.5rem;
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--border-light);
    transition: all var(--transition);
    position: relative;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .promo-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: var(--accent-warm);
  }

  .promo-card__badge {
    position: absolute;
    top: -10px;
    right: 16px;
    background: var(--accent-terracotta);
    color: #fff;
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.2rem 0.9rem;
    border-radius: 50px;
    font-family: var(--font-sans);
  }

  .promo-card__icon {
    font-size: 2.4rem;
    margin-bottom: 0.3rem;
  }

  .promo-card__discount {
    font-family: var(--font-serif);
    font-size: 2.6rem;
    font-weight: 700;
    color: var(--accent-terracotta);
    line-height: 1.1;
    margin-bottom: 0.1rem;
  }

  .promo-card__title {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.25rem;
  }

  .promo-card__description {
    font-size: 0.88rem;
    color: var(--text-body);
    margin-bottom: 0.5rem;
    line-height: 1.5;
  }

  .promo-card__day {
    font-size: 0.78rem;
    color: var(--text-muted);
    background: var(--bg);
    padding: 0.2rem 0.9rem;
    border-radius: 50px;
    font-family: var(--font-sans);
  }
</style>