---
interface Props {
  title: string;
  description: string;
  href: string;
  icon?: string;
}

const {
  title,
  description,
  href,
  icon = "✦",
} = Astro.props;
---

<a href={href} class="promo-card">
  <div class="promo-card__icon" aria-hidden="true">
    {icon}
  </div>

  <div class="promo-card__content">
    <h2>{title}</h2>
    <p>{description}</p>
  </div>

  <span class="promo-card__arrow" aria-hidden="true">
    →
  </span>
</a>

<style>
  .promo-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 300px;
    padding: 2.5rem;
    overflow: hidden;

    color: var(--color-text);
    text-decoration: none;

    background: rgba(253, 252, 249, 0.95);
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);

    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease,
      background-color 0.3s ease;
  }

  .promo-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 4px;

    background: var(--color-primary);
    transform: scaleX(0);
    transform-origin: left;

    transition: transform 0.3s ease;
  }

  .promo-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.12);
  }

  .promo-card:hover::before {
    transform: scaleX(1);
  }

  .promo-card:focus-visible {
    outline: 3px solid var(--color-primary);
    outline-offset: 4px;
  }

  .promo-card__icon {
    display: flex;
    align-items: center;
    justify-content: center;

    width: 52px;
    height: 52px;
    margin-bottom: 2rem;

    font-size: 1.25rem;
    color: var(--color-primary);

    border: 1px solid currentColor;
    border-radius: 50%;
  }

  .promo-card__content {
    flex: 1;
  }

  .promo-card h2 {
    margin: 0 0 0.75rem;

    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 2.5vw, 2.4rem);
    font-weight: 500;
    line-height: 1.15;

    color: var(--color-text);
  }

  .promo-card p {
    max-width: 28rem;
    margin: 0;

    font-size: 0.95rem;
    line-height: 1.7;

    color: var(--color-text-light);
  }

  .promo-card__arrow {
    align-self: flex-end;

    margin-top: 2rem;

    font-size: 1.5rem;
    line-height: 1;

    color: var(--color-primary);

    transition: transform 0.3s ease;
  }

  .promo-card:hover .promo-card__arrow {
    transform: translateX(6px);
  }

  @media (max-width: 768px) {
    .promo-card {
      min-height: 250px;
      padding: 2rem;
    }

    .promo-card__icon {
      margin-bottom: 1.5rem;
    }
  }
</style>