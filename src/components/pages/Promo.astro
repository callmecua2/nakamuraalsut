---
import PromoCard from "../UI/PromoCard.astro"
import {promosData} from "../../data/promos.js"

const { promos, footer } = promosData;

---

<section class="promo-section">
  <div class="container-custom">
    <!-- Header -->
    <div class="promo-section__header">
      <span class="promo-section__subtitle">✨ Special Offer</span>
      <h1 class="promo-section__title">
        👘PROMO <br class="mobile-break" />
        <span class="highlight">NAKAMURA</span> ALAM SUTERA
      </h1>
      <p class="promo-section__desc">
        Nikmati berbagai diskon spesial hanya di Nakamura Alam Sutera
      </p>
    </div>

    <!-- Grid Promo -->
    <div class="promo-grid">
      {promos.map((promo) => (
        <PromoCard
          title={promo.title}
          description={promo.description}
          day={promo.day}
          discount={promo.discount}
          icon={promo.icon}
          badge={promo.badge}
        />
      ))}
    </div>

    <!-- Footer Info -->
    <div class="promo-section__footer">
      <p class="promo-section__note">{footer.note}</p>

      <div class="promo-section__contact">
        <div class="contact-item">
          <span class="contact-icon">📱</span>
          <span class="contact-label">WA:</span>
          <a href={`https://wa.me/62${footer.wa.replace(/\s/g, '')}`} class="contact-value">
            {footer.wa}
          </a>
        </div>
        <div class="contact-item">
          <span class="contact-icon">📍</span>
          <span class="contact-value">{footer.address}</span>
        </div>
      </div>

      <a href="https://wa.me/6285778899198" class="btn-reserve">
        ✨ RESERVASI SEKARANG
      </a>
    </div>
  </div>
</section>

<style>
  .promo-section {
    padding: 4rem 0 5rem;
    background: var(--bg);
    min-height: 100vh;
  }

  .promo-section__header {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .promo-section__subtitle {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent-terracotta);
    background: var(--promo-badge-bg);
    padding: 0.25rem 1.2rem;
    border-radius: 50px;
    margin-bottom: 0.75rem;
    font-family: var(--font-sans);
  }

  .promo-section__title {
    font-family: var(--font-serif);
    font-size: 2.4rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.2;
    margin-bottom: 0.75rem;
  }

  .promo-section__title .highlight {
    color: var(--accent-terracotta);
  }

  .mobile-break {
    display: none;
  }

  .promo-section__desc {
    font-size: 1.05rem;
    color: var(--text-muted);
    max-width: 500px;
    margin: 0 auto;
  }

  .promo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1.75rem;
    margin-bottom: 3.5rem;
  }

  .promo-section__footer {
    text-align: center;
    max-width: 620px;
    margin: 0 auto;
    padding-top: 2rem;
    border-top: 1px solid var(--border-light);
  }

  .promo-section__note {
    font-size: 0.85rem;
    color: var(--text-muted);
    font-style: italic;
    margin-bottom: 1.25rem;
    font-family: var(--font-sans);
  }

  .promo-section__contact {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-bottom: 1.75rem;
    font-size: 0.92rem;
  }

  .contact-item {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .contact-icon {
    font-size: 1.1rem;
  }

  .contact-label {
    font-weight: 600;
    color: var(--text-primary);
  }

  .contact-value {
    color: var(--text-body);
  }

  .contact-value a {
    color: var(--accent-terracotta);
    text-decoration: none;
    font-weight: 600;
  }

  .contact-value a:hover {
    text-decoration: underline;
  }

  .btn-reserve {
    display: inline-block;
    background: var(--accent-terracotta);
    color: #fff;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: 0.04em;
    padding: 0.85rem 2.8rem;
    border-radius: 50px;
    text-decoration: none;
    transition: all var(--transition);
    box-shadow: 0 4px 16px rgba(140, 67, 31, 0.25);
  }

  .btn-reserve:hover {
    background: var(--accent-terracotta-hover);
    transform: translateY(-2px);
    box-shadow: 0 8px 28px rgba(140, 67, 31, 0.35);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .promo-section {
      padding: 2.5rem 0 3.5rem;
    }

    .promo-section__title {
      font-size: 1.8rem;
    }

    .mobile-break {
      display: block;
    }

    .promo-grid {
      grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
      gap: 1.25rem;
    }

    .promo-section__contact {
      font-size: 0.85rem;
    }

    .btn-reserve {
      font-size: 0.85rem;
      padding: 0.7rem 2rem;
      width: 100%;
      text-align: center;
    }
  }

  @media (max-width: 480px) {
    .promo-grid {
      grid-template-columns: 1fr 1fr;
      gap: 0.9rem;
    }

    .promo-section__title {
      font-size: 1.4rem;
    }
  }
</style>