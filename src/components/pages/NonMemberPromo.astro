---
const promos = [
  {
    number: "01",
    title: "Happy Hour",
    discount: "5%",
    description:
      "Nikmati harga spesial untuk mengembalikan kesegaran tubuh di jam Happy Hour.",
    detail: "Selasa–Kamis · 10.00–14.00",
    note: "Berlaku di luar tanggal merah",
  },
  {
    number: "02",
    title: "Lansia Weekday",
    discount: "20%",
    description:
      "Nikmati apresiasi khusus bagi pelanggan lansia yang berkunjung di hari kerja.",
    detail: "Senin–Jumat · Usia 65 tahun ke atas",
    note: "Berlaku di luar tanggal merah",
  },
  {
    number: "03",
    title: "Lansia Weekend",
    discount: "5%",
    description:
      "Tetap hemat di akhir pekan dengan promo khusus pelanggan lansia.",
    detail: "Sabtu–Minggu · Usia 65 tahun ke atas",
    note: "",
  },
];
---

<div class="page-fixed-bg"></div>
<main class="non-member-promo">
  <header class="promo-header">
    <a href="/promo" class="back-link">
      <span aria-hidden="true">←</span> Semua Promo
    </a>
    <p class="eyebrow">SPECIAL NON-MEMBER OFFER</p>
    <h1>New Promo Non Member<br /> <span>Nakamura Alam Sutera</span></h1>
    <p class="intro">
      Butuh badan segar kembali? Manfaatkan promo khusus Non-Member kami.
    </p>
  </header>
  <section class="promo-content" aria-label="Daftar promo non member">
    <div class="promo-grid">
      {
        promos.map((promo) => (
          <article class="promo-card">
            {" "}
            <div class="card-top">
              {" "}
              <span class="promo-number">{promo.number}</span>{" "}
              <span class="discount">{promo.discount}</span>{" "}
            </div>{" "}
            <div class="card-content">
              {" "}
              <h2>{promo.title}</h2> <p>{promo.description}</p>{" "}
            </div>{" "}
            <div class="card-detail"> {promo.detail} </div>{" "}
            {promo.note && (
              <div class="card-note">
                {" "}
                <span aria-hidden="true">✦</span> {promo.note}{" "}
              </div>
            )}{" "}
          </article>
        ))
      }
    </div>
  </section>
  <section class="reservation">
    <p class="reservation-eyebrow">RESERVASI SEKARANG</p>
    <div class="reservation-content">
      <div>
        <span class="reservation-label">WhatsApp</span>
        <a href="https://wa.me/6285778899198" target="_blank" rel="noopener">
          085 778899 198
        </a>
      </div>
      <div>
        <span class="reservation-label">Lokasi</span>
        <address>Ruko Jalur Sutera Kav. 20A No. 02,<br /> Alam Sutera</address>
      </div>
    </div>
  </section>
</main>
<style>
  .non-member-promo {
    position: relative;
    z-index: 1;
    min-height: 100vh;
    padding: 8rem 2rem 6rem;
  }
  .promo-header {
    max-width: 950px;
    margin: 0 auto 4.5rem;
    text-align: center;
    color: #fff;
  }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 2.5rem;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .back-link:hover {
    color: #fff;
  }
  .back-link span {
    font-size: 1.1rem;
    transition: transform 0.2s ease;
  }
  .back-link:hover span {
    transform: translateX(-4px);
  }
  .eyebrow {
    margin: 0 0 1.25rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.8);
  }
  .promo-header h1 {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    font-weight: 500;
    line-height: 1.08;
  }
  .promo-header h1 span {
    color: rgba(255, 255, 255, 0.78);
  }
  .intro {
    max-width: 620px;
    margin: 1.5rem auto 0;
    font-size: 1rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.82);
  }
  .promo-content {
    max-width: 1150px;
    margin: 0 auto;
  }
  .promo-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }
  .promo-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 300px;
    padding: 2rem;
    overflow: hidden;
    background: rgba(253, 252, 249, 0.96);
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }
  .promo-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 4px;
    background: var(--color-primary);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s ease;
  }
  .promo-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.12);
  }
  .promo-card:hover::before {
    transform: scaleX(1);
  }
  .card-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }
  .promo-number {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--color-text-light);
  }
  .discount {
    font-family: var(--font-serif);
    font-size: 2.5rem;
    line-height: 1;
    color: var(--color-primary);
  }
  .card-content {
    flex: 1;
  }
  .card-content h2 {
    margin: 0 0 0.7rem;
    font-family: var(--font-serif);
    font-size: 1.65rem;
    font-weight: 500;
    line-height: 1.15;
    color: var(--color-text);
  }
  .card-content p {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--color-text-light);
  }
  .card-detail {
    margin-top: 1.75rem;
    padding-top: 1rem;
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.5;
    letter-spacing: 0.03em;
    color: var(--color-text);
    border-top: 1px solid rgba(0, 0, 0, 0.08);
  }
  .card-note {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.75rem;
    font-size: 0.7rem;
    line-height: 1.4;
    color: var(--color-text-light);
  }
  .card-note span {
    color: var(--color-primary);
  }
  .reservation {
    max-width: 1150px;
    margin: 4rem auto 0;
    padding: 2.5rem;
    color: #fff;
    background: rgba(0, 0, 0, 0.22);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: var(--radius-lg);
    backdrop-filter: blur(10px);
  }
  .reservation-eyebrow {
    margin: 0 0 2rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.75);
  }
  .reservation-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
  }
  .reservation-label {
    display: block;
    margin-bottom: 0.5rem;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
  }
  .reservation a {
    font-family: var(--font-serif);
    font-size: 1.7rem;
    color: #fff;
    text-decoration: none;
  }
  .reservation a:hover {
    text-decoration: underline;
  }
  .reservation address {
    font-size: 0.95rem;
    font-style: normal;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.9);
  }
  @media (max-width: 900px) {
    .promo-grid {
      grid-template-columns: 1fr;
      max-width: 650px;
      margin: 0 auto;
    }
  }
  @media (max-width: 650px) {
    .non-member-promo {
      padding: 7rem 1.25rem 4rem;
    }
    .promo-header {
      margin-bottom: 3rem;
    }
    .promo-header h1 {
      font-size: clamp(2.3rem, 10vw, 3.3rem);
    }
    .promo-card {
      min-height: 260px;
    }
    .reservation {
      padding: 2rem 1.5rem;
    }
    .reservation-content {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
